# Copy to `.env.local` and fill in. The same variables must be set in
# Netlify → Site configuration → Environment variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudinary (product images) ---
# Browser uploads use an *unsigned* upload preset
# (Settings → Upload → Upload presets → Signing Mode = "Unsigned").
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Server only — used by /api/cloudinary/delete to remove replaced/deleted images.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EmailJS: contact form (runs in the browser) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- EmailJS: new-order email to the shop owner (server only) ---
# EMAILJS_ORDER_TEMPLATE_ID is a separate template; see
# docs/email-templates/order_notification.html (local only).
EMAILJS_SERVICE_ID=
EMAILJS_ORDER_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
OWNER_NOTIFICATION_EMAIL=

# --- Site address ---
# Used for the admin link in order emails and for canonical / share-preview
# URLs. Set to the live domain, e.g. https://astorija.mk
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
